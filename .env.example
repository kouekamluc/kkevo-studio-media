# KKEVO STUDIO MEDIA Environment Configuration
# "Facts. Perspective. Impact."

# Django Configuration
DEBUG=True
SECRET_KEY=kkevo-dev-secret-key-change-in-production-african-media-49827103
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL in production, SQLite fallback in local development)
DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL: postgres://kkevo_user:kkevo_secure_pass@localhost:5432/kkevo_db

# CORS & CSRF
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Redis & Celery (Optional for local dev, enabled for Docker/production)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# Media & Storage (Local for dev, S3-compatible in production)
MEDIA_URL=/media/
STATIC_URL=/static/

# Frontend URL
FRONTEND_URL=http://localhost:5173
